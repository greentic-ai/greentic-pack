{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "baseBranches": ["develop", "release"],
  "labels": ["dependencies", "renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ci/deps-dev\\.toml$"],
      "matchStrings": [
        "(?m)^greentic-qa-lib\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*$"
      ],
      "depNameTemplate": "greenticai/greentic-qa",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchBaseBranches": ["develop"],
      "matchFileNames": ["ci/deps-dev.toml"],
      "automerge": true,
      "automergeType": "pr",
      "allowedVersions": "/-dev\\./"
    },
    {
      "matchBaseBranches": ["release"],
      "matchFileNames": ["ci/deps-dev.toml"],
      "enabled": false
    }
  ]
}